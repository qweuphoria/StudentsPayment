<Page x:Class="StudentsPayment.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PaymentsPage">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SearchTextBox" Width="170" Margin="0,0,10,0" TextChanged="SearchTextBox_TextChanged"/>

            <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="MonthFilterComboBox" Width="140" SelectionChanged="MonthFilterComboBox_SelectionChanged" Margin="0,0,10,0">
                <ComboBoxItem Content="Все" IsSelected="True"/>
            </ComboBox>

            <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="YearFilterTextBox" Width="100" TextChanged="YearFilterTextBox_TextChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="PaymentsDataGrid" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding payment_id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="ID студента" Binding="{Binding student_id}"/>
                <DataGridTextColumn Header="Дата оплаты" Binding="{Binding payment_date, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding amount}"/>
                <DataGridTextColumn Header="Месяц" Binding="{Binding month}"/>
                <DataGridTextColumn Header="Год" Binding="{Binding year}"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Добавить" Click="AddButton_Click" Width="110" Margin="0,0,10,0"/>
            <Button x:Name="EditButton" Content="Редактировать" Click="EditButton_Click" Width="110" Margin="0,0,10,0"/>
            <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Width="110" Margin="0,0,10,0"/>
            <Button x:Name="RefreshButton" Content="Обновить" Click="RefreshButton_Click" Width="110" Margin="0,0,20,0"/>
            <Button x:Name="ExportDocButton" Content="Экспорт в .doc" Click="ExportDocButton_Click" Width="130" Margin="0,0,10,0"/>
            <Button x:Name="ExportXlsButton" Content="Экспорт в .xls" Click="ExportXlsButton_Click" Width="130"/>
        </WrapPanel>
    </Grid>
</Page>
